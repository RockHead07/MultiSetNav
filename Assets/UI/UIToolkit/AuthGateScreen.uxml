<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/UIToolkit/AuthGateScreen.uss?fileID=7433441132597879392&amp;guid=81a3f10942e1b9f44b3f8b917ad767c8&amp;type=3#AuthGateScreen"/>
    <ui:VisualElement name="root" class="authgate-root">
        <ui:VisualElement name="hero" class="hero">
            <ui:VisualElement name="app-icon" class="app-icon">
                <ui:VisualElement class="app-icon-img"/>
            </ui:VisualElement>
            <ui:Label name="app-name" text="MultiSetNav" class="app-name"/>
            <ui:Label name="headline" text="Selamat datang" class="headline"/>
            <ui:Label name="subtitle" text="Kampus dalam genggamanmu" class="subtitle"/>
        </ui:VisualElement>
        <ui:VisualElement name="bottom-sheet" class="bottom-sheet">
            <ui:Button name="btn-login" text="→  Masuk dengan akun" class="btn-primary" style="height: 118px; font-size: 36px;"/>
            <ui:Button name="btn-register" text="+  Daftar akun baru" class="btn-secondary" style="height: 118px; font-size: 36px;"/>
            <ui:VisualElement name="divider-row" class="divider-row" style="-unity-background-image-tint-color: rgb(150, 160, 175);">
                <ui:VisualElement class="divider-line" style="height: 4px;"/>
                <ui:Label text="atau" class="divider-text" style="font-size: 36px;"/>
                <ui:VisualElement class="divider-line" style="height: 4px;"/>
            </ui:VisualElement>
            <ui:Button name="btn-guest" text="Lanjut sebagai tamu" class="btn-guest" style="font-size: 36px; height: 116px; -unity-text-align: upper-center;"/>
            <ui:VisualElement name="info-box" class="info-box" style="-unity-text-align: middle-left;">
                <ui:Label text="ⓘ" class="info-icon" style="font-size: 63px; -unity-text-align: middle-left; height: 72px;"/>
                <ui:Label text="Mode tamu hanya bisa navigasi dasar tanpa riwayat &amp; notifikasi" class="info-text" style="font-size: 24px; height: 75px; -unity-text-align: middle-left;"/>
            </ui:VisualElement>
            <ui:VisualElement class="spacer"/>
            <ui:Label name="footer-text" text="Dengan masuk, kamu menyetujui Syarat &amp; Ketentuan kami" class="footer-text" style="font-size: 22px; height: 264px; -unity-text-align: lower-center;"/>
            <ui:VisualElement name="home-indicator" class="home-indicator"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
